# --- Supabase ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → Connection string
# Pooled (port 6543, ?pgbouncer=true) — used at runtime by src/db/client.ts
DATABASE_URL=
# Direct (port 5432) — used by drizzle-kit for migrations only
DIRECT_DATABASE_URL=

# Used to build the emailRedirectTo URL for magic links and signup
# confirmation emails (src/app/login/actions.ts, src/app/signup/actions.ts).
# Defaults to http://localhost:3000 if unset — only needs setting for a
# deployed environment. Must also be added to Supabase Auth → URL
# Configuration → Redirect URLs as "<value>/auth/callback", or the
# confirmation/magic links will fail.
NEXT_PUBLIC_SITE_URL=

# --- AI ---
ANTHROPIC_API_KEY=

# --- Notifications (addendum #5) ---
# Leave RESEND_API_KEY unset until email is wired up; Slack/Teams webhook
# URLs are per-organisation and stored in notification_channels.config,
# not here.
RESEND_API_KEY=

# Email for invites, admin-change notices and help requests (optional).
# Without RESEND_API_KEY nothing is sent: invites still work, the admin shares
# the sign-up link themselves. Use a sending-only key for the verified domain.
RESEND_API_KEY=
# Optional. Defaults to "Product Discovery <login@bpmngenie.com>".
EMAIL_FROM=
# Where "Contact the people who run this service" messages are emailed.
# They are always stored in support_requests as well.
SUPPORT_EMAIL=
