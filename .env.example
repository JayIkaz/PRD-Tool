# --- Supabase ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → Connection string
# Pooled (port 6543, ?pgbouncer=true) — used at runtime by src/db/client.ts
DATABASE_URL=
# Direct (port 5432) — used by drizzle-kit for migrations only
DIRECT_DATABASE_URL=

# --- AI ---
ANTHROPIC_API_KEY=

# --- Notifications (addendum #5) ---
# Leave RESEND_API_KEY unset until email is wired up; Slack/Teams webhook
# URLs are per-organisation and stored in notification_channels.config,
# not here.
RESEND_API_KEY=
